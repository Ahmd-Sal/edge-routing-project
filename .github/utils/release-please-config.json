{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "bootstrap-sha": "f4c7860",
  "tag-separator": "@",
  "include-v-in-tag": false,
  "packages": {
    ".": {
      "release-type": "go",
      "package-name": "go-api"
    }
  },
  "changelog-sections": [
    {
      "type": "feat",
      "section": "Features"
    },
    {
      "type": "fix",
      "section": "Bug Fixes"
    },
    {
      "type": "chore",
      "section": "Chores"
    },
    {
      "type": "revert",
      "section": "Reverts"
    }
  ]
}
